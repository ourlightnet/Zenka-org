# Repo-root .gitignore for zenka-org

# Scraped from old Squarespace site, large + reference-only, not deployed
/archive/

# Local-only HTML mockup artifacts (the chosen design lives in /site/)
/mockups/

# OS / editor cruft
.DS_Store
.idea/
.vscode/
*.swp

# Stray duplicate — the real one lives at site/public/BingSiteAuth.xml
/BingSiteAuth.xml

# Catch any nested node_modules outside /site/
node_modules/
